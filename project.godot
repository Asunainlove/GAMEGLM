; Engine configuration file.
; Edit through the Godot editor where practical.

config_version=5

[application]

config/name="星壤：余辉纪元"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameState="*res://src/state/game_state.gd"
SaveService="*res://src/save/save_service.gd"
ContentDB="*res://src/content/content_db.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://themes/starsoil_theme.tres"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

