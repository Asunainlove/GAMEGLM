{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starsoil:schemas/event.schema.json",
  "title": "Starsoil narrative event",
  "type": "object",
  "required": ["id", "kind", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "kind": {"enum": ["dialogue", "choice", "mixed"]},
    "requires_flag": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
    "once": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {}},
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {"const": "line"},
            "speaker": {"type": "string", "minLength": 1},
            "text_zh": {"type": "string", "minLength": 1}
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {"const": "choice"},
            "choice_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "prompt_zh": {"type": "string", "minLength": 1},
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["id", "text_zh"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                  "text_zh": {"type": "string", "minLength": 1},
                  "set_flag": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                  "requires_trust": {"type": "integer", "minimum": 0, "maximum": 100},
                  "relation_delta": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "char_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                      "dim": {"enum": ["affection", "trust", "ideology"]},
                      "delta": {"type": "integer", "minimum": -100, "maximum": 100}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {"const": "effect"},
            "flag_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "flag_value": {"type": "boolean"},
            "relation_delta": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "char_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "dim": {"enum": ["affection", "trust", "ideology"]},
                "delta": {"type": "integer", "minimum": -100, "maximum": 100}
              }
            },
            "grant_items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["item_id", "amount"],
                "additionalProperties": false,
                "properties": {
                  "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                  "amount": {"type": "integer", "minimum": 1}
                }
              }
            },
            "due_encounter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        }
      ]
    }
  }
}
