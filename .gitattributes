*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# GUT vendor images are tiny binaries shipped in-tree; keep them as normal git
# blobs so CI does not depend on LFS objects that may never have been pushed.
addons/gut/**/*.png -filter -diff -merge binary

# Keep the unmodified GUT vendor bytes and do not apply project whitespace rules.
addons/gut/** -text whitespace=-trailing-space,-space-before-tab
